# App
NODE_ENV=development
API_PORT=4000
# Production providers usually set PORT automatically.
PORT=
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-in-production

# Database
DB_PROVIDER=pglite
PGLITE_DATA_DIR=memory
DATABASE_SSL=false
POSTGRES_USER=financebot
POSTGRES_PASSWORD=financebot
POSTGRES_DB=financebot
DATABASE_URL=postgres://financebot:financebot@localhost:5432/financebot

# WhatsApp provider
WHATSAPP_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=change-this-verify-token
META_GRAPH_API_VERSION=v26.0
PUBLIC_DASHBOARD_URL=http://localhost:5173
